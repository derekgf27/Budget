# Neon Postgres (required for data)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Plaid (sandbox — optional until you connect cards)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# Public app URL (for Plaid redirect / webhooks / reminder links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email check-in reminders (Resend + Vercel Cron)
# https://resend.com/api-keys — free tier works for your own inbox
RESEND_API_KEY=
# Optional; defaults to Splitbook <onboarding@resend.dev>
REMINDER_FROM_EMAIL=
# Fallback if not set in Settings
REMINDER_EMAIL=
# Used for “today” calendar date; send time is always 1pm America/New_York
REMINDER_TZ=America/New_York
CRON_SECRET=
# Set to 0 to disable (Settings toggle overrides)
EMAIL_REMINDERS_ENABLED=1

# AI Coach (Google Gemini free tier) — optional; without it, Home still shows number-based tips
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional alias for the same key
GEMINI_API_KEY=
# Optional model override (default gemini-3.6-flash)
AI_COACH_MODEL=
