# App unlock (required)
APP_PIN=1234
SESSION_SECRET=change-me-to-a-long-random-string

# Neon Postgres (required for data)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Plaid (sandbox — optional until you connect cards)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# Public app URL (for Plaid redirect / webhooks in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
